# =============================================================================
# Commandi — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Providers (free tiers) — used to read pasted chats ---
# Set at least one key. Requests fall back through every configured provider.
# With no key at all, `next dev` uses a built-in sample; production refuses.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_QUALITY=gemini-flash-latest

# OpenRouter (":free" models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local only: set AI_PROVIDER=ollama to use Ollama instead of the chain above
AI_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
